{
  "name": "discordia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @discordia/web --",
    "build": "npm run build -w @discordia/web",
    "dev:backoffice": "npm run dev -w @discordia/backoffice --",
    "build:backoffice": "npm run build -w @discordia/backoffice",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @discordia/web --",
    "test:e2e:ui": "npm run test:e2e:ui -w @discordia/web --",
    "test:e2e:headed": "npm run test:e2e -w @discordia/web -- --headed",
    "test:e2e:codegen": "npm run test:e2e:codegen -w @discordia/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start -w @discordia/mobile --",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
