# =========================================================
# Development Environment with Hot Module Replacement (HMR)
# =========================================================
FROM node:22-alpine

WORKDIR /app

# Monorepo (npm workspaces): solo las dependencias de la web y de los paquetes compartidos
COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY apps/backoffice/package.json apps/backoffice/
COPY packages/core/package.json packages/core/
COPY packages/tokens/package.json packages/tokens/
RUN npm install --workspace=@discordia/web --include-workspace-root

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
