# URL del API Gateway (Kong)
VITE_API_URL=http://localhost:8000

# Los WebSockets (chat y voz) usan la misma URL que la API, con ws:// o wss://: no hace falta otra variable

# Auth0 (Single Page Application). Sin definir, la web usa el tenant de desarrollo del equipo
# (apps/web/src/platform/auth/auth0.ts). Descomentar solo para usar otro tenant.
# VITE_AUTH0_DOMAIN=dev-dppme5iaqg60gkmo.us.auth0.com
# VITE_AUTH0_CLIENT_ID=f2H8PhlKDl3KSIm64G5mHAeQih7iFyIP
# VITE_AUTH0_AUDIENCE=https://api.discordia.com

# Modo Mock solo para desarrollo desconectado (ignorado en build de producción)
VITE_USE_MOCK=false

