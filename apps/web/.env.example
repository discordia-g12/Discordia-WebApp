# URL del API Gateway (Kong)
VITE_API_URL=http://localhost:8000

# URL del servicio WebSocket de Chat
VITE_WS_URL=ws://localhost:8000

# Parámetros de Auth0 (Single Page Application)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.discordia.app

# Modo Mock solo para desarrollo desconectado (ignorado en build de producción)
VITE_USE_MOCK=false

