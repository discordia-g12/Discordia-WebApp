# Headers de Cloudflare Pages (equivalente a los add_header de nginx.conf, que Pages no usa).
# Vite copia este archivo tal cual a dist/. La vuelta a index.html de las rutas de la SPA la hace
# Pages solo (no hay 404.html).

/*
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade

# Solo los archivos con hash en el nombre (los genera Vite en /assets) se pueden cachear para siempre
/assets/*
  Cache-Control: public, max-age=31536000, immutable
