# Opcional. Sin definir, la app usa la IP de la máquina que corre Metro, puerto 8000 (el Gateway local).
# Para probar contra producción (los builds de EAS ya la traen en eas.json):
# EXPO_PUBLIC_API_URL=https://api.discordia.lol

# Opcional, solo en desarrollo: arranca con sesión y datos simulados, sin backend ni Auth0.
# EXPO_PUBLIC_USE_MOCK=true
# Con el mock: hace sonar una llamada de ese usuario (u1) a los 10 s de abrir la app.
# EXPO_PUBLIC_MOCK_INCOMING_CALL=u1
