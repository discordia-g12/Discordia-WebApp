# URL del API Gateway (Kong)
VITE_API_URL=http://localhost:8000

# Auth0: aplicación "Discordia Backoffice" (Single Page Application), distinta de la de la web.
# Allowed Callback URLs: http://localhost:5174/callback, https://backoffice.discordia.lol/callback
# Allowed Logout URLs y Allowed Web Origins: http://localhost:5174, https://backoffice.discordia.lol
# Sin VITE_AUTH0_CLIENT_ID el backoffice no puede iniciar sesión (salvo en modo mock).
VITE_AUTH0_CLIENT_ID=
# Sin definir, el tenant y la API de desarrollo del equipo (los mismos que la web)
# VITE_AUTH0_DOMAIN=dev-dppme5iaqg60gkmo.us.auth0.com
# VITE_AUTH0_AUDIENCE=https://api.discordia.com

# Grafana (Observabilidad). No está publicado: en producción se abre con el port forwarding de SSM
# (docs/ARQUITECTURA.md del orquestador, sección 10), que lo deja en este mismo puerto
VITE_GRAFANA_URL=http://localhost:3030

# Cliente web, para el link "ir a Discordia"
VITE_APP_URL=http://localhost:5173

# Modo mock: entra como staff sin Auth0 ni backend. Solo en desarrollo (el build de producción lo ignora)
VITE_USE_MOCK=false
